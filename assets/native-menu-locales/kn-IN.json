್ ವೇಗವಾಗಿ ಆರಂಭವಾಗಿ ಉತ್ತಮವಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ. Apple Silicon ಬಿಲ್ಡ್ ಅನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಈಗ ನಿರ್ಗಮಿಸಿ, ಅಥವಾ Intel ಬಿಲ್ಡ್‌ನೊಂದಿಗೆ ಮುಂದುವರಿಯಿರಿ","desktop.intelLaunchWarning.message":"Apple Silicon Mac ನಲ್ಲಿ {appName} Intel ಬಿಲ್ಡ್‌ನಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿದೆ","desktop.intelLaunchWarning.quit":"ನಿರ್ಗಮಿಸಿ","desktop.quitConfirmation.activeLocalAndScheduledTasksDetail":"ಈ ಮಷಿನ್‌ನಲ್ಲಿನ ಸಕ್ರಿಯ ಲೋಕಲ್‌ ಚಾಟ್‌ಗಳಿಗೆ ಅಡ್ಡಿಯಾಗುತ್ತದೆ ಮತ್ತು {appName} ಮುಚ್ಚಿರುವಾಗ ನಿಗದಿತ ಕಾರ್ಯಗಳು ರನ್‌ ಆಗುವುದಿಲ್ಲ","desktop.quitConfirmation.activeLocalTasksDetail":"ಈ ಮಷಿನ್‌ನಲ್ಲಿನ ಸಕ್ರಿಯ ಲೋಕಲ್‌ ಚಾಟ್‌ಗಳಿಗೆ ಅಡ್ಡಿಯಾಗುತ್ತದೆ","desktop.quitConfirmation.cancel":"ರದ್ದುಮಾಡಿ","desktop.quitConfirmation.pendingWorktreeAndLocalChatsDetail":"ಹೊಸ ವರ್ಕ್‌ಟ್ರೀಗಳಲ್ಲಿ ಇನ್ನೂ ಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತಿರುವ ಚಾಟ್‌ಗಳು, ರಿಮೋಟ್ ಹೋಸ್ಟ್‌ಗಳಲ್ಲಿರುವುದು ಸೇರಿದಂತೆ, ಕಳೆದುಹೋಗಬಹುದು. ಸಕ್ರಿಯ ಸ್ಥಳೀಯ ಚಾಟ್‌ಗಳಿಗೆ ಅಡ್ಡಿಯಾಗುತ್ತದೆ","desktop.quitConfirmation.pendingWorktreeAndScheduledTasksDetail":"ರಿಮೋಟ್ ಹೋಸ್ಟ್‌ಗಳಲ್ಲಿರುವುದು ಸೇರಿದಂತೆ, ಹೊಸ ವರ್ಕ್‌ಟ್ರೀಗಳಲ್ಲಿ ಇನ್ನೂ ಪ್ರಾರಂಭವಾಗುತ್ತಿರುವ ಚಾಟ್‌ಗಳು ಕಳೆದುಹೋಗಬಹುದು. {appName} ಮುಚ್ಚಿರುವಾಗ ನಿಗದಿತ ಕಾರ್ಯಗಳು ರನ್ ಆಗುವುದಿಲ್ಲ","desktop.quitConfirmation.pendingWorktreeChatsDetail":"ರಿಮೋಟ್ ಹೋಸ್ಟ್‌ಗಳಲ್ಲಿರುವುದು ಸೇರಿದಂತೆ, ಹೊಸ ವರ್ಕ್‌ಟ್ರೀಗಳಲ್ಲಿ ಇನ್ನೂ ಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತಿರುವ ಚಾಟ್‌ಗಳು ಕಳೆದುಹೋಗಬಹುದು","desktop.quitConfirmation.pendingWorktreeLocalAndScheduledTasksDetail":"ಹೊಸ ವರ್ಕ್‌ಟ್ರೀಗಳಲ್ಲಿ ಇನ್ನೂ ಪ್ರಾರಂಭವಾಗುತ್ತಿರುವ ಚಾಟ್‌ಗಳು ರಿಮೋಟ್ ಹೋಸ್ಟ್‌ಗಳಲ್ಲಿಯೂ ಕಳೆದುಹೋಗಬಹುದು. ಸಕ್ರಿಯ ಸ್ಥಳೀಯ ಚಾಟ್‌ಗಳಿಗೆ ಅಡಚಣೆಯಾಗುತ್ತದೆ ಮತ್ತು {appName} ಮುಚ್ಚಿರುವಾಗ ನಿಗದಿತ ಕಾರ್ಯಗಳು ರನ್ ಆಗುವುದಿಲ್ಲ","desktop.quitConfirmation.quit":"ನಿರ್ಗಮಿಸಿ","desktop.quitConfirmation.scheduledTasksDetail":"{appName} ಮುಚ್ಚಿರುವಾಗ ನಿಗದಿಪಡಿಸಲಾದ ಕಾರ್ಯಗಳು ರನ್ ಆಗುವುದಿಲ್ಲ","desktop.quitConfirmation.title":"{appName} ನಿಂದ ನಿರ್ಗಮಿಸಬೇಕೆ?","desktop.remoteHostedPIP.closeControlTooltip":"ಪಿಕ್ಚರ್-ಇನ್-ಪಿಕ್ಚರ್ ಅನ್ನು Codex‌ ಗೆ ಹಿಂತಿರುಗಿಸಿ","desktop.remoteHostedPIP.hideControl":"ಮರೆಮಾಡಿ","desktop.remoteHostedPIP.hideForAllActiveTasks":"ಎಲ್ಲಾ ಸಕ್ರಿಯ ಚಾಟ್‌ಗಳಿಗೆ ಮರೆಮಾಡಿ","desktop.remoteHostedPIP.hideForTask":"ಈ ಚಾಟ್‌ಗಾಗಿ ಮರೆಮಾಡಿ","desktop.remoteHostedPIP.sendToPetControlTooltip":"ಪಿಕ್ಚರ್-ಇನ್-ಪಿಕ್ಚರ್ ಅನ್ನು ವರ್ಚುವಲ್‌ ಸಾಕುಪ್ರಾಣಿಗೆ ಕಳುಹಿಸಿ","desktop.requirementsAuthRecovery.detail":"ನಿಮ್ಮ ಸೆಷನ್ ಇನ್ನು ಮಾನ್ಯವಾಗಿಲ್ಲ. {appName} ತೆರೆಯಲು ಪುನಃ ಸೈನ್ ಇನ್ ಮಾಡಿ","desktop.requirementsAuthRecovery.quit":"ನಿರ್ಗಮಿಸಿ","desktop.requirementsAuthRecovery.retryDetail":"{appName} ಗೆ ನಿಮ್ಮನ್ನು ಸೈನ್ ಔಟ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಸೈನ್-ಇನ್‌ಗೆ ಹಿಂತಿರುಗಲು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ","desktop.requirementsAuthRecovery.signIn":"ಪುನಃ ಸೈನ್ ಇನ್ ಮಾಡಿ","desktop.requirementsAuthRecovery.title":"ಮುಂದುವರಿಯಲು ಸೈನ್ ಇನ್ ಮಾಡಿ","desktop.workspacePolicyRecovery.configDetailWithLocation":"Codex‌ನ ಸಂರಚನೆಯನ್ನು ಸರಿಪಡಿಸುವವರೆಗೆ ಅದನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಕೆಳಗಿನ ಫೈಲ್ ಅನ್ನು ತೆರೆಯಿರಿ, ಸೂಚಿಸಲಾದ ಸಮಸ್ಯೆಯನ್ನು ಸರಿಪಡಿಸಿ, ಫೈಲ್ ಅನ್ನು ಉಳಿಸಿ, ನಂತರ “ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ” ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಸಂಸ್ಥೆ ಈ ಫೈಲ್ ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತಿದ್ದರೆ, ನಿಮ್ಮ IT ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.{paragraphBreak}{location}{lineBreak}{detail}","desktop.workspacePolicyRecovery.configDetailWithoutLocation":"Codex‌ನ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಸರಿಪಡಿಸುವವರೆಗೆ ಅದು ಪ್ರಾರಂಭವಾಗಲು ಸಾಧ್ಯವಿಲ್ಲ. ಕೆಳಗಿನ ಸಮಸ್ಯೆಯನ್ನು ಪತ್ತೆಹಚ್ಚಲು ನಿಮ್ಮ Codex ಹೋಮ್ ಫೋಲ್ಡರ್‌ನಲ್ಲಿರುವ config.toml ಫೈಲ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ, ನಿಮ್ಮ ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸಿ, ನಂತರ “ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ” ಆಯ್ಕೆಮಾಡಿ. ನಿಮಗೆ ಆ ಸೆಟ್ಟಿಂಗ್ ಸಿಗದಿದ್ದರೆ ಅಥವಾ ಅದನ್ನು ನಿಮ್ಮ ಸಂಸ್ಥೆ ನಿರ್ವಹಿಸುತ್ತಿದ್ದರೆ, ನಿಮ್ಮ IT ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.{paragraphBreak}{detail}","desktop.workspacePolicyRecovery.configTitle":"Codex ಸಂರಚನೆಯನ್ನು ಲೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ","desktop.workspacePolicyRecovery.detail":"ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಲೋಡ್‌ ಮಾಡುವವರೆಗೆ ಆ್ಯಪ್‌ ಅನ್ನು ವಿರಾಮಗೊಳಿಸಲಾಗಿದೆ. ನೆಟ್‌ವರ್ಕ್‌ ಸಂಪರ್ಕ, ಪ್ರಾಕ್ಸಿ ಅಥವಾ ಫೈರ್‌ವಾಲ್‌ ಪ್ರವೇಶವನ್ನು ತಡೆಯುತ್ತಿರಬಹುದು. ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ, ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ ಬೇರೆ ಖಾತೆಯನ್ನು ಬಳಸಲು ಸೈನ್‌ ಔಟ್‌ ಮಾಡಿ. ಸಮಸ್ಯೆ ಮುಂದುವರಿದರೆ, ನಿಮ್ಮ IT ನಿರ್ವಾಹಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.","desktop.workspacePolicyRecovery.quit":"ನಿರ್ಗಮಿಸಿ","desktop.workspacePolicyRecovery.retry":"ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ","desktop.workspacePolicyRecovery.signOut":"ಸೈನ್ ಔಟ್ ಮಾಡಿ","desktop.workspacePolicyRecovery.title":"ಸಂಸ್ಥೆಯ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಲೋಡ್ ಮಾಡಲಾಗಲಿಲ್ಲ","desktop.workspacePolicyRestart.detail":"ನಿಮ್ಮ ಕಾರ್ಯಸ್ಥಳದ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅನ್ವಯಿಸಲು {appName} ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ. ಸಕ್ರಿಯ ಸ್ಥಳೀಯ ಚಾಟ್‌ಗಳು ಸ್ಥಗಿತಗೊಳ್ಳುತ್ತವೆ","desktop.workspacePolicyRestart.restart":"ಮರುಪ್ರಾರಂಭಿಸಿ","desktop.workspacePolicyRestart.title":"ಕಾರ್ಯಸ್ಥಳದ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಅನ್ವಯಿಸಲು ಮರುಪ್ರಾರಂಭಿಸಿ","electron.appMenu.app.checkForUpdates":"ಅಪ್‌ಡೇಟ್‌ಗಳಿಗಾಗಿ ಪರಿಶೀಲಿಸಿ…","electron.appMenu.app.hide":"{appName} ಅನ್ನು ಮರೆಮಾಡಿ","electron.appMenu.app.hideOthers":"ಇತರ ಆ್ಯಪ್‌ಗಳನ್ನು ಮರೆಮಾಡಿ","electron.appMenu.app.quit":"{appName} ನಿಂದ ನಿರ್ಗಮಿಸಿ","electron.appMenu.app.services":"ಸೇವೆಗಳು","electron.appMenu.app.showAll":"ಎಲ್ಲವನ್ನೂ ತೋರಿಸಿ","electron.appMenu.edit.copy":"ನಕಲಿಸಿ","electron.appMenu.edit.cut":"ಕತ್ತರಿಸಿ","electron.appMenu.edit.delete":"ಅಳಿಸಿ","electron.appMenu.edit.paste":"ಅಂಟಿಸಿ","electron.appMenu.edit.pasteAndMatchStyle":"ಅಂಟಿಸಿ ಮತ್ತು ಶೈಲಿಗೆ ಹೊಂದಿಸಿ","electron.appMenu.edit.redo":"ಮತ್ತೆ ಮಾಡಿ","electron.appMenu.edit.selectAll":"ಎಲ್ಲವನ್ನೂ ಆಯ್ಕೆಮಾಡಿ","electron.appMenu.edit.showSubstitutions":"ಪರ್ಯಾಯಗಳನ್ನು ತೋರಿಸಿ","electron.appMenu.edit.smartDashes":"ಸ್ಮಾರ್ಟ್ ಡ್ಯಾಶ್‌ಗಳು","electron.appMenu.edit.smartQuotes":"ಸ್ಮಾರ್ಟ್ ಉದ್ಧರಣ ಚಿಹ್ನೆಗಳು","electron.appMenu.edit.speech":"ಮಾತು","electron.appMenu.edit.startSpeaking":"ಮಾತನಾಡಲು ಪ್ರಾರಂಭಿಸಿ","electron.appMenu.edit.stopSpeaking":"ಮಾತನಾಡುವುದನ್ನು ನಿಲ್ಲಿಸಿ","electron.appMenu.edit.substitutions":"ಪರ್ಯಾಯಗಳು","electron.appMenu.edit.textReplacement":"ಪಠ್ಯ ಬದಲಾವಣೆ","electron.appMenu.edit.undo":"ರದ್ದುಮಾಡು","electron.appMenu.file.newWindow":"ಹೊಸ ವಿಂಡೋ","electron.appMenu.help.systemStatus":"ಸಿಸ್ಟಮ್ ಸ್ಥಿತಿ","electron.appMenu.help.taskManager":"ಟಾಸ್ಕ್ ಮ್ಯಾನೇಜರ್","electron.appMenu.help.troubleshooting":"ಟ್ರಬಲ್‌ಶೂಟಿಂಗ್","electron.appMenu.trace.awaitingDetails":"ಟ್ರೇಸ್ ವಿವರಗಳಿಗಾಗಿ ಕಾಯಲಾಗುತ್ತಿದೆ…","electron.appMenu.trace.awaitingStart":"ಟ್ರೇಸ್ ಪ್ರಾರಂಭಿಸಲು ಕಾಯಲಾಗುತ್ತಿದೆ…","electron.appMenu.trace.saving":"ಟ್ರೇಸ್ ಉಳಿಸಲಾಗುತ್ತಿದೆ…","electron.appMenu.trace.start":"ಕಾರ್ಯಕ್ಷಮತೆ ಟ್ರೇಸ್ ಪ್ರಾರಂಭಿಸಿ","electron.a